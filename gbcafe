<style>
*{box-sizing:border-box}
html,body,#map{margin:0;width:100%;height:100%;font-family:Arial,"Noto Sans KR",sans-serif}
#map{height:100vh}
.control{
 position:absolute;z-index:1000;top:18px;left:18px;width:350px;
 background:#fffdf7;border-radius:22px;padding:20px;border:1px solid rgba(78,101,75,.16);
 box-shadow:0 8px 30px rgba(0,0,0,.16);backdrop-filter:blur(8px)
}
h1{font-size:23px;margin:0 0 4px;color:#314d38;letter-spacing:-.8px}
.sub{font-size:11px;color:#7a806f;margin-bottom:16px;letter-spacing:1px}
label{font-size:12px;font-weight:bold;display:block;margin:10px 0 5px}
select,input{width:100%;padding:10px;border:1px solid #ddd;border-radius:9px;background:white}
.count{margin-top:12px;padding:10px 12px;background:#eaf0e5;border-radius:10px;font-size:12px;color:#4f654f;font-weight:700}
.style-buttons{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}
.style-buttons button{
 border:1px solid #ddd;background:#fff;border-radius:9px;padding:9px;cursor:pointer
}
.style-buttons button.active{background:#536f57;color:#fff;border-color:#536f57}
.legend{font-size:10.5px;color:#858878;margin-top:10px;line-height:1.55}
.popup-title{font-size:16px;font-weight:bold;margin-bottom:7px}
.popup-row{font-size:12px;line-height:1.55;margin:2px 0}
@media(max-width:600px){
 .control{width:calc(100% - 28px);left:14px;top:14px}
}
</style>
</head>
