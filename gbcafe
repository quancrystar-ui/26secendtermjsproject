const map = L.map('map', {center:[36.45,128.65], zoom:8});

const CARTO_KEY = "cb1_470r_1_37071f8dd35fe50d7659f3a7";
const tileStyles = {
 voyager: {url:"https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key="+CARTO_KEY,attr:"© OpenStreetMap contributors © CARTO",maxZoom:20},
 light: {url:"https://basemaps.cartocdn.com/rastertiles/light_all/{z}/{x}/{y}{r}.png?key="+CARTO_KEY,attr:"© OpenStreetMap contributors © CARTO",maxZoom:20},
 dark: {url:"https://basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}{r}.png?key="+CARTO_KEY,attr:"© OpenStreetMap contributors © CARTO",maxZoom:20},
 osm: {url:"https://tile.openstreetmap.org/{z}/{x}/{y}.png",attr:"© OpenStreetMap contributors",maxZoom:19}
};
let tiles;

function setStyle(name){
 if(tiles) map.removeLayer(tiles);
 const s=tileStyles[name];
 tiles=L.tileLayer(s.url,{maxZoom:19,attribution:s.attr}).addTo(map);
 document.querySelectorAll('.style-buttons button').forEach(b=>b.classList.toggle('active',b.dataset.style===name));
}
setStyle('voyager');

const cluster=L.markerClusterGroup({chunkedLoading:true,showCoverageOnHover:false,maxClusterRadius:55});
map.addLayer(cluster);

const cities=[...new Set(cafes.map(c=>c.sigungu).filter(Boolean))].sort();
const city=document.getElementById('city');
cities.forEach(x=>{const o=document.createElement('option');o.value=x;o.textContent=x;city.appendChild(o)});

function esc(s){
 return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function popup(c){
 return `<div>
 <div class="popup-title">☕ ${esc(c.name)}</div>
 <div class="popup-row"><b>지역</b> ${esc(c.sigungu)}</div>
 <div class="popup-row"><b>도로명</b> ${esc(c.addr||'-')}</div>
 <div class="popup-row"><b>지번</b> ${esc(c.jibun||'-')}</div>
 <div class="popup-row"><b>전화</b> ${esc(c.phone||'-')}</div>
 <div class="popup-row"><b>좌표</b> ${c.lat.toFixed(6)}, ${c.lng.toFixed(6)}</div>
 </div>`;
}
function render(){
 cluster.clearLayers();
 const q=document.getElementById('search').value.trim().toLowerCase();
 const selected=city.value;
 let n=0;
 cafes.forEach(c=>{
   const text=(c.name+' '+c.addr+' '+c.jibun+' '+c.sigungu).toLowerCase();
   if(selected && c.sigungu!==selected) return;
   if(q && !text.includes(q)) return;
   const m=L.marker([c.lat,c.lng]).bindPopup(popup(c));
   cluster.addLayer(m); n++;
 });
 document.getElementById('count').textContent=`표시: ${n.toLocaleString()}곳 / 경상북도 좌표 데이터: ${cafes.length.toLocaleString()}곳`;
}
document.querySelectorAll('.style-buttons button').forEach(b=>b.onclick=()=>setStyle(b.dataset.style));
city.onchange=render;
document.getElementById('search').oninput=render;
render();
</script>
